# ==============================================================================
# Synchro PRO - Configuração Opcional do Agente de IA CFPS (IFPUG CPM 4.3.1)
# ==============================================================================
# Você também pode configurar e testar estas credenciais diretamente pela interface
# do Synchro PRO (botão "🤖 Configurar IA" na tela de APF ou no Auditor CFPS).

# Provedor padrão: gemini | openai | anthropic | openai_compatible
AI_PROVIDER=gemini

# Modelo recomendado para o provedor escolhido:
# - gemini: gemini-3.8-flash | gemini-4-argon | gemini-3.5-flash-lite
# - openai: gpt-4.1 | gpt-4o | o4-mini
# - anthropic: claude-sonnet-4-5 | claude-opus-4-1
# - openai_compatible (Ollama/OpenRouter/Groq): llama3.1 | qwen2.5
AI_MODEL=gemini-3.5-flash-lite

# Chave de API (use AI_API_KEY ou a chave específica do provedor)
AI_API_KEY=
# GEMINI_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# Endpoint customizado (obrigatório apenas para Ollama / OpenRouter / Groq / Proxy)
# Ex.: http://localhost:11434/v1
AI_BASE_URL=

